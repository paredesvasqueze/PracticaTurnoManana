@model Models.DepartamentoHospital
@{
    ViewData["Title"] = "Editar Departamento Hospitalario";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* Campo oculto para mantener el Id del departamento *@
    <input type="hidden" asp-for="nIdDepartamento" />

    <div class="form-group mb-3">
        <label asp-for="cNombre">Nombre del Departamento</label>
        <input asp-for="cNombre" class="form-control" />
        <span asp-validation-for="cNombre" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="cDescripcion">Descripción</label>
        <input asp-for="cDescripcion" class="form-control" />
        <span asp-validation-for="cDescripcion" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="nCantidadPersonal">Cantidad de Personal</label>
        <input asp-for="nCantidadPersonal" class="form-control" />
        <span asp-validation-for="nCantidadPersonal" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="cUbicacion">Ubicación</label>
        <input asp-for="cUbicacion" class="form-control" />
        <span asp-validation-for="cUbicacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}