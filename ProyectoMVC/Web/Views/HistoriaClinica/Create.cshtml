@model Models.HistoriaClinica

<h2>Crear Historia Clínica</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="nIdPaciente"></label>
        <input asp-for="nIdPaciente" class="form-control" />
        <span asp-validation-for="nIdPaciente" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="dFechaRegistro"></label>
        <input asp-for="dFechaRegistro" class="form-control" type="date" />
        <span asp-validation-for="dFechaRegistro" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="cDiagnostico"></label>
        <textarea asp-for="cDiagnostico" class="form-control"></textarea>
        <span asp-validation-for="cDiagnostico" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="cTratamiento"></label>
        <textarea asp-for="cTratamiento" class="form-control"></textarea>
        <span asp-validation-for="cTratamiento" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="cObservaciones"></label>
        <textarea asp-for="cObservaciones" class="form-control"></textarea>
        <span asp-validation-for="cObservaciones" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
