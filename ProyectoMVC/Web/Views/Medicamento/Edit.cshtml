@model Models.Medicamento
@*
  ViewData["Title"] = "Editar Medicamento";  
*@
@{
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    @* Campo oculto para mantener el Id del medicamento *@
    <input type="hidden" asp-for="nIdMedicamento" />

    <div class="form-group">
        <label asp-for="cNombre"></label>
        <input asp-for="cNombre" class="form-control" />
        <span asp-validation-for="cNombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="cDescripcion"></label>
        <input asp-for="cDescripcion" class="form-control" />
        <span asp-validation-for="cDescripcion" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="cPresentacion"></label>
        <input asp-for="cPresentacion" class="form-control" />
        <span asp-validation-for="cPresentacion" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="nPrecioUnitario"></label>
        <input asp-for="nPrecioUnitario" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="nPrecioUnitario" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="nStock"></label>
        <input asp-for="nStock" class="form-control" type="number" />
        <span asp-validation-for="nStock" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
