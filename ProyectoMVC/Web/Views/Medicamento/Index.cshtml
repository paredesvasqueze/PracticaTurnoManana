@model IEnumerable<Models.Medicamento>
@*
   ViewData["Title"] = "Listado de Medicamentos";
*@
@{
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">@ViewData["Title"]</h2>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Medicamento
        </a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Precio Unitario</th>
                <th>Presentación</th>
                <th>Stock</th>
                <th style="width:180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.nIdMedicamento</td>
                        <td>@item.cNombre</td>
                        <td>@item.nPrecioUnitario.ToString("C")</td>
                        <td>@item.cPresentacion</td>
                        <td>@item.nStock</td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.nIdMedicamento" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.nIdMedicamento" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.nIdMedicamento" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No hay medicamentos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
