@model Models.Medicamento

<form id="formMedicamento">
    <input type="hidden" id="nIdMedicamento" value="@Model.nIdMedicamento" />
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input class="form-control" id="cNombre" value="@Model.cNombre" />
    </div>
    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <input class="form-control" id="cDescripcion" value="@Model.cDescripcion" />
    </div>
    <div class="mb-3">
        <label class="form-label">Presentación</label>
        <input class="form-control" id="cPresentacion" value="@Model.cPresentacion" />
    </div>
    <div class="mb-3">
        <label class="form-label">Precio Unitario</label>
        <input class="form-control" id="nPrecioUnitario" type="number" step="0.01" value="@Model.nPrecioUnitario" />
    </div>
    <div class="mb-3">
        <label class="form-label">Stock</label>
        <input class="form-control" id="nStock" type="number" value="@Model.nStock" />
    </div>

    <div class="text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-success" onclick="guardarMedicamento()">Guardar</button>
    </div>
</form>
