@model Models.Medico

@{
    ViewData["Title"] = "Registrar Médico";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-3">
        <label asp-for="cCMP"></label>
        <input asp-for="cCMP" class="form-control" />
        <span asp-validation-for="cCMP" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="cNombre"></label>
        <input asp-for="cNombre" class="form-control" />
        <span asp-validation-for="cNombre" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="cApellido"></label>
        <input asp-for="cApellido" class="form-control" />
        <span asp-validation-for="cApellido" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="cEspecialidad"></label>
        <input asp-for="cEspecialidad" class="form-control" />
        <span asp-validation-for="cEspecialidad" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="cTelefono"></label>
        <input asp-for="cTelefono" class="form-control" />
        <span asp-validation-for="cTelefono" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="cCorreo"></label>
        <input asp-for="cCorreo" class="form-control" />
        <span asp-validation-for="cCorreo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
</form>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}
