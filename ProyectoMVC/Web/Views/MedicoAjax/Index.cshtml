@model IEnumerable<Models.Medico>

@{
    ViewData["Title"] = "Gestión de Médicos";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">@ViewData["Title"]</h2>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> Nuevo Médico
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark text-center">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Especialidad</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th style="width:180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var medico in Model)
                {
                    <tr>
                        <td class="text-center">@medico.nIdMedico</td>
                        <td>@medico.cNombre</td>
                        <td>@medico.cApellido</td>
                        <td>@medico.cEspecialidad</td>
                        <td>@medico.cTelefono</td>
                        <td>@medico.cCorreo</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@medico.nIdMedico" class="btn btn-sm btn-warning me-1">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@medico.nIdMedico" class="btn btn-sm btn-info me-1">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            <a asp-action="Delete" asp-route-id="@medico.nIdMedico" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-3">
                        <i class="bi bi-person-bounding-box"></i> No hay médicos registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
